{
  "name": "pmp-dsh-tavern",
  "version": "3.0.0",
  "description": "A SillyTavern compatibility plugin that keeps DSH authoritative over sessions and execution, with frontend and backend APIs for composing Tavern capabilities with native DSH features.",
  "type": "module",
  "main": "packages/tavern-loader/src/index.js",
  "exports": {
    ".": "./packages/tavern-loader/src/index.js",
    "./format": "./packages/tavern-format/src/index.js",
    "./loader": "./packages/tavern-loader/src/index.js",
    "./world-book": "./packages/world-book/src/index.js",
    "./world-book-library": "./packages/world-book-library/src/index.js",
    "./preset": "./packages/preset/src/index.js",
    "./character": "./packages/character/src/index.js",
    "./user": "./packages/user/src/index.js",
    "./trace": "./packages/tavern-trace/src/index.js",
    "./session-template": "./packages/session-template/src/index.js",
    "./client": "./dist/client.js",
    "./identity": "./packages/identity.js",
    "./package.json": "./package.json",
    "./request-assembler": "./packages/request-assembler/index.js",
    "./mvu": "./packages/mvu-adapter/src/index.js",
    "./prompt-template": "./packages/prompt-template/index.js",
    "./memory-sources": "./packages/memory-sources/index.js",
    "./opening-worldbook": "./packages/opening-worldbook/index.js",
    "./opening-worldbook/manifest": "./packages/opening-worldbook/manifest.js",
    "./scope-catalog": "./packages/scope-catalog/index.js",
    "./history-policy": "./packages/history-policy/index.js"
  },
  "files": [
    "screenshots.json",
    "README_en.md",
    "SECURITY.md",
    "SECURITY_en.md",
    "packages",
    "dist",
    "scripts",
    "docs/assets",
    "docs/OPERATION_LOGS.md",
    "docs/OPERATION_LOGS_en.md",
    "docs/API.md",
    "docs/API_en.md",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE_en.md",
    "CHANGELOG.md",
    "docs/DSH_0.1.7_MIGRATION.md",
    "docs/DSH_0.1.7_MIGRATION_en.md",
    "docs/DSH_MESSAGE_FLOW.md",
    "docs/DSH_MESSAGE_FLOW_en.md",
    "docs/FRONTEND_INTEGRATION_zh-CN.md",
    "docs/FRONTEND_INTEGRATION_en.md",
    "docs/INSTALLATION.md",
    "docs/INSTALLATION_en.md",
    "docs/LOADER_CONTRACT.md",
    "docs/LOADER_CONTRACT_en.md",
    "docs/PROMPT_PIPELINE.md",
    "docs/PROMPT_PIPELINE_en.md",
    "docs/RP_SECURE_MODE.md",
    "docs/RP_SECURE_MODE_en.md",
    "docs/USAGE_zh-CN.md",
    "docs/USAGE_en.md",
    "docs/world-book",
    "cordis.patch.yml",
    "docs/PROMPT_API_V3.md",
    "docs/PROMPT_API_V3_en.md",
    "docs/TESTING.md",
    "docs/TESTING_en.md",
    "docs/examples",
    "docs/CONVERSATION_PRESENTATION.md",
    "docs/CONVERSATION_PRESENTATION_en.md",
    "docs/REQUEST_ASSEMBLY.md",
    "docs/REQUEST_ASSEMBLY_en.md",
    "docs/MVU.md",
    "docs/MVU_en.md",
    "docs/PROMPT_TEMPLATE.md",
    "docs/PROMPT_TEMPLATE_en.md",
    "docs/ASSEMBLER_INTEGRATION.md",
    "docs/ASSEMBLER_INTEGRATION_en.md",
    "docs/API_SURFACES.md",
    "docs/API_SURFACES_en.md",
    "docs/RESOURCE_LAYOUT.md",
    "docs/RESOURCE_LAYOUT_en.md",
    "docs/HISTORY_POLICY.md",
    "docs/HISTORY_POLICY_en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "check": "npm run build && npm test",
    "verify:2.0": "node scripts/verify-2.0.mjs && npm run build && npm run pack:check",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "plugin:install": "node scripts/install.mjs",
    "plugin:uninstall": "node scripts/uninstall.mjs",
    "pack:with-assembler": "node scripts/pack-with-assembler.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-util-crypto": "0.2.0-rc.2",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-util-crypto": "0.2.0-rc.2"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/standalone": "7.26.10",
    "@jitl/quickjs-singlefile-browser-release-asyncify": "0.31.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.31.0",
    "acorn": "8.15.0",
    "acorn-jsx": "5.3.2",
    "dompurify": "3.4.16",
    "dsh-prompt-assembler": "github:Player-MINEPIG/dsh-prompt-assembler#4be47ae20a2e475bf352c3e1abc84197d5c1dde5",
    "json5": "2.2.3",
    "katex": "0.18.2",
    "linkedom": "0.18.12",
    "marked": "18.0.10",
    "quickjs-emscripten-core": "0.31.0",
    "yaml": "2.9.1"
  }
}
